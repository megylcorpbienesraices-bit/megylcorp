# === WEB LOGIN ===
APP_NAME=ITM QUANT MULTI ASSET
APP_ENV=production

# === DATOS ===
DATA_MODE=auto
REFRESH_SECONDS=15
# Revalorización LIVE de TRACE: cada cuántos segundos se reconstruyen los perfiles
# contra el spot actual. Más bajo = más fluido; más alto = menos CPU.
ITM_TRACE_LIVE_REPRICE_SECONDS=2
FLOW_REFRESH_SECONDS=30
STRIKE_WINDOW=12
EXPIRY_DAYS=21
PREMARKET_FREEZE_MINUTES=5

# === ALPACA MARKET DATA ===
ALPACA_API_KEY=PEGAR_AQUI_LA_NUEVA_API_KEY
ALPACA_SECRET_KEY=PEGAR_AQUI_LA_NUEVA_SECRET_KEY
ALPACA_STOCK_FEED=sip
ALPACA_OPTIONS_FEED=opra

# === QUANT DATA · OPTIONS INTELLIGENCE · CORROBORATION ONLY ===
# ITM QUANT conserva autoridad matemática: Gamma/Delta/GEX/DEX y estructura son nativos.
QUANTDATA_ENABLED=1
QUANTDATA_API_KEY=PEGAR_AQUI_TU_QUANTDATA_API_KEY
QUANTDATA_BASE_URL=https://api.quantdata.us
QUANTDATA_REFRESH_SECONDS=15
# === PLAZOS Y CONCURRENCIA ===
#
# v1.58.0 · QUANTDATA_TIMEOUT_SECONDS YA NO ES LA AUTORIDAD.
#
# Esta variable gobernaba el arranque en frio de todos los endpoints. Con el
# valor 5 que repartia el instalador, TODO endpoint sin historia moria a los
# cinco segundos y el plazo adaptativo no gobernaba nada: la consola de
# produccion mostro ocho endpoints cortados exactamente en 5.0 s.
#
# Ahora:
#   · el plazo de LECTURA lo fija el p95 medido de cada endpoint;
#   · mientras no hay muestras se usa el warm start (12 s de politica);
#   · esta variable solo se respeta si pide MAS paciencia que el warm start;
#     un valor mas corto se IGNORA y el Auditor lo dice.
# No hace falta editarla: se deja por compatibilidad con .env existentes.
QUANTDATA_TIMEOUT_SECONDS=12

# Plazo de CONEXION, independiente del de lectura. Son dos fallos distintos:
# conectar es un ida y vuelta de red; leer depende de lo que tarde el proveedor
# en calcular la respuesta. Un solo numero para los dos obliga a elegir mal.
QUANTDATA_CONNECT_TIMEOUT_SECONDS=4

# Peticiones SIMULTANEAS. La cuota cuenta peticiones (240/60 s, 20/1 s); esto
# cuenta peticiones VIVAS. Veinte mapas por intervalo a la vez cumplen la cuota
# y se ahogan entre ellos: la congestion la provocamos nosotros y se lee como
# lentitud del proveedor.
QUANTDATA_MAX_INFLIGHT=4

# De esas, cuantas pueden ser PESADAS a la vez (cadena entera, cinta del dia,
# series largas). Cuatro ligeras no se parecen a cuatro mapas por intervalo.
QUANTDATA_MAX_HEAVY_INFLIGHT=2
# Presupuesto del plan contratado. Declararlo es la forma definitiva de evitar que
# la cuota se agote: sin esto el ritmo se infiere de las cabeceras del proveedor y,
# si no publican la ventana, se asume la DIARIA por prudencia.
#   Ejemplo plan de 240 peticiones por hora:  240 y 3600
#   Ejemplo plan de 240 peticiones por dia:   240 y 86400
QUANTDATA_PLAN_REQUESTS=
QUANTDATA_PLAN_WINDOW_SECONDS=


# === PRECISION ENGINE v1.13 ===
# Inputs del modelo. Ajustar con datos vigentes; no son pronósticos automáticos.
ITM_RISK_FREE_RATE=0.045
# Overrides opcionales por activo; si se omiten se usan fallbacks específicos del motor.
# ITM_DIVIDEND_YIELD_DIA=0.017
# ITM_DIVIDEND_YIELD_SPY=0.012
# ITM_DIVIDEND_YIELD_QQQ=0.005
# ITM_DIVIDEND_YIELD_AAPL=0.004

# Memoria rápida y Calibration Lab
HOT_SNAPSHOTS=240
CALIBRATION_MIN_SAMPLES=30

# Regime Engine: SHADOW por defecto. Activar solo tras validación walk-forward.
ITM_ADAPTIVE_SCANNER=0

# === DEALER INTELLIGENCE / RESEARCH v1.14 ===
# Cost proxies for Calibration Lab. Leave blank until measured from real fills.
# Blank means NET metrics are unavailable; ITM QUANT never silently assumes zero cost.
ITM_BACKTEST_SLIPPAGE_BPS=
ITM_BACKTEST_COST_BPS=

# Dealer counterparty base scenario is currently 70% inside the model; UI also shows 30% and 100% sensitivity.
# Dealer inventory/open-close/hedge outputs are estimates and remain SHADOW until calibrated.

# === v1.14.2 · OPENING/CLOSING CALIBRATION ===
# SHADOW fitting is collected automatically. LIVE use remains OFF by default.
# Set to 1 only after the purged holdout beats the constant baseline consistently.
ITM_OPENING_CALIBRATION=0
ITM_OPENING_MIN_CONTRACTS=200
ITM_OPENING_MIN_SESSIONS=5
ITM_OPENING_MIN_VOLUME=25
ITM_OPENING_RIDGE=1.0
# === v1.14.4 · EXPECTED VALUE / PROBABILITY CALIBRATION ===
# Por defecto SOLO visible en SHADOW/CALIBRATED. No bloquea señales hasta habilitarlo explícitamente.
ITM_EV_GATE_ACTIVE=0
ITM_EV_ACTIONABLE_R=0.15
ITM_EV_CAUTION_R=0.0
# ITM_BACKTEST_COST_R intentionally blank/unset until measured from real fills.
ITM_BACKTEST_COST_R=
ITM_CALIB_MIN_BRIER_SKILL=0.02
# Evaluación de research: underlying u options. Options usa P&L TEÓRICO con IV constante.
ITM_INSTRUMENT_MODE=underlying
ITM_OPTION_HALF_SPREAD_PCT=2.5
# Anchors históricos: sesión actual queda pendiente y solo se promueve en una sesión posterior.
ITM_ANCHOR_MIN_SESSIONS=3
ITM_NET_TILT_FLOOR_Q=0.25


# === v1.14.4 · INSTRUMENT-CONSISTENT EV / PARTIAL POOLING ===
# Shrinkage Global -> Expiry: w_scope = n_scope / (n_scope + k).
ITM_CALIB_POOLING_K=100
# Minimum sample to fit an expiry-specific SHADOW component for pooling.
ITM_CALIB_SCOPE_MIN_SAMPLES=40
ITM_CALIB_SCOPE_MIN_SESSIONS=20
# Options EV requires historical T1/invalidation times; no synthetic fallback is used.
# Risk unit in options = MODEL_TO_INVALIDATION; full premium is reported separately.

# Horizonte de calibración preferido del EV Gate; usa el disponible más cercano.
ITM_EV_GATE_HORIZON_MIN=10

# === v1.14.8 · LEAN SOURCE STACK ===
# Stack LIVE: Alpaca SIP/OPRA + tastytrade/DXLink; Quant Data aporta inteligencia de opciones normalizada.
# Gamma/Delta/GEX/DEX y la estructura permanecen bajo autoridad matemática nativa de ITM QUANT.
# Macro oficial permanece como contexto, no como tape de mercado.
# No existen campos para Cboe/LiveVol, ChartExchange, CME/CBOT, Bookmap, Reuters,
# SpotGamma, Market Chameleon, OptionCharts ni Yahoo Finance.
ITM_SOURCE_TIMEOUT=6

# === v1.14.7 · LIVE VALIDATION / EMPIRICAL PARTIAL POOLING ===
# Probability calibration global thresholds used by the running model and validation panel.
ITM_CALIB_MIN_SAMPLES=120
ITM_CALIB_MIN_SESSIONS=40
# Scope/global pooling: k is now only a candidate prior, never the final weight by decree.
ITM_CALIB_POOL_WEIGHT_STEP=0.05
ITM_CALIB_POOL_MIN_SELECT_SAMPLES=10
ITM_CALIB_POOL_MIN_TEST_SAMPLES=10
# Gate remains OFF until explicitly enabled after OOS validation.
ITM_EV_GATE_ACTIVE=0

# TRACE multiframe tape context (SHADOW; calibrable with LIVE history)
ITM_TIMEFLOW_DEAD_BAND=1.60

# === v1.15.5 · VOLATILITY + STRUCTURE STOP (LIVE HEURISTIC + SHADOW RESEARCH) ===
# Horizonte usado para estimar el ruido normal del subyacente.
ITM_STOP_HORIZON_MIN=10
# k LIVE inicial. Es heurístico y debe validarse con historia real; alternativas 1.00/1.25/1.50/1.75 se guardan en SHADOW.
ITM_STOP_K_SIGMA=1.25
# Solo una estructura cercana y suficientemente fuerte puede ampliar la invalidación.
ITM_STOP_STRUCTURAL_SCORE_MIN=65
ITM_STOP_STRUCTURAL_MAX_STEPS=2.0

# === v1.23 ULTRA-LOW-LATENCY / GPU OPTIONAL BACKENDS ===
# Rust causal microservice. Remains READY unless the independently built process is running.
ITM_RUST_CAUSALITY=0
ITM_RUST_CAUSAL_ENDPOINT=tcp://127.0.0.1:5555
ITM_RUST_ZMQ_BIND=tcp://127.0.0.1:5555
# Transitional existing Alpaca SIP/OPRA -> Rust PULL bridge. Disable when a direct provider adapter is active.
ITM_RUST_PYTHON_FORWARD=0
ITM_RUST_INGEST_BIND=tcp://127.0.0.1:5554
ITM_RUST_INGEST_ENDPOINT=tcp://127.0.0.1:5554
ITM_CAUSAL_MAX_LATENESS_MS=350
ITM_RUST_INGRESS_CAPACITY=1000000

# Live hot-state mirror. In-process RAM remains authoritative if Redis is unavailable.
ITM_REDIS_URL=
ITM_HOTSTATE_FLUSH_SECONDS=5

# GPU quant kernels. AUTO = CuPy/CUDA -> JAX accelerator -> JAX CPU -> NumPy.
ITM_ACCELERATED_QUANT=1
ITM_ACCELERATOR_BACKEND=AUTO

# Direct feed adapter intentionally has no fake default. Configure a real provider adapter.
ITM_DIRECT_FEED_PROVIDER=
ITM_DIRECT_FEED_URI=
ITM_RUST_METRICS_ADDR=127.0.0.1:9555
ITM_RUST_REPLAY_WIRE=
ITM_RUST_SPOOL_WIRE=

# v1.25.2 · ADAPTIVE LIVE SCHEDULER
# SIP/OPRA remain event-driven. These values only govern heavier structural/flow refreshes.
ITM_ADAPTIVE_REFRESH_ENABLED=1
ITM_STRUCT_ACTIVE_SECONDS=5
ITM_STRUCT_NORMAL_SECONDS=10
ITM_STRUCT_QUIET_SECONDS=20
ITM_FLOW_ACTIVE_SECONDS=10
ITM_FLOW_NORMAL_SECONDS=20
ITM_FLOW_QUIET_SECONDS=45
ITM_ADAPTIVE_WAKE_SECONDS=1

# === v1.25.17 · TASTYTRADE READ-ONLY + PROVIDER DATA LAKE ===
# Keep real credentials only in your local .env. Never commit or paste them into source files.
TASTYTRADE_ENABLED=1
TASTYTRADE_CLIENT_ID=
TASTYTRADE_CLIENT_SECRET=
TASTYTRADE_REFRESH_TOKEN=
TASTYTRADE_BASE_URL=https://api.tastyworks.com
TASTYTRADE_USER_AGENT=ITM-QUANT/1.27.22
# Progressive derivative hydration. Safe defaults; does not block asset switching.
TASTYTRADE_STREAM_DERIVATIVES=1
TASTYTRADE_DERIVATIVE_MAX_DTE=14
TASTYTRADE_DERIVATIVE_EXPIRATIONS=3
TASTYTRADE_DERIVATIVE_STRIKES_PER_EXPIRY=24
TASTYTRADE_DERIVATIVE_MAX_CONTRACTS=180

# === v1.25.17 · FULL PROVIDER COVERAGE / COLD LIBRARY ===
# HOT remains tactical; WARM/COLD collectors run in background and never block Scanner/TRACE.
PROVIDER_LIBRARY_ENABLED=1
PROVIDER_LIBRARY_ASSET_INTERVAL_SECONDS=75
PROVIDER_LIBRARY_ALPACA_CATALOG_DAYS=365
PROVIDER_LIBRARY_ALPACA_SNAPSHOT_DAYS=30
PROVIDER_DATA_LAKE_QUEUE=250000
TASTYTRADE_CATALOG_ENABLED=1
TASTYTRADE_CATALOG_REFRESH_MINUTES=60
TASTYTRADE_CATALOG_ASSET_DELAY_MS=150

# === v1.25.17 · ACTIVE ASSET ECOSYSTEM FUSION ===
# Related ETF/equity observations are sampled asynchronously. Futures/indexes use
# compatible providers (for example tastytrade) and never fall back to fabricated data.
ITM_ECOSYSTEM_REFRESH_SECONDS=4
# v1.26.4 startup/chain resilience (bounded; no credential/auth errors are retried)
ITM_QUANT_ALPACA_RETRY_ATTEMPTS=3
ITM_QUANT_TASTY_CHAIN_FAILOVER_WAIT_SECONDS=10


# === v1.26.5 · ALWAYS-ON ENGINE + INSTANT CALENDAR ===
# The engine can run without an open browser. For true operation while the local PC is
# physically off, deploy run_always_on.py / docker-compose.always-on.yml on a 24/7 host.
ITM_ALWAYS_ON=1
# Persist an already-rendered state + charts + tables package after Quant refreshes.
ITM_READY_PACKAGE_SECONDS=20
# Proactively prepare recent persisted sessions so a date click reads a READY package.
ITM_HISTORY_PRECOMPUTE_SESSIONS=370
ITM_HISTORY_PRECOMPUTE_DELAY_SECONDS=8
# Local default stays loopback. A VPS container sets this to 0.0.0.0 internally and
# should be reached only behind VPN or authenticated HTTPS reverse proxy.
ITM_BIND_HOST=127.0.0.1
ITM_PORT=8000
# Obligatorio (mínimo 32 caracteres) si el motor queda expuesto de cualquier forma:
# bind externo, ITM_TRUST_PROXY=1 o ITM_REQUIRE_TOKEN=1.
ITM_ACCESS_TOKEN=
# v1.27.6 · Poner en 1 cuando el motor escuche en loopback DETRÁS de un reverse
# proxy (nginx, Caddy, Traefik). Sin esto, el bind loopback desactivaba toda la
# autenticación y el proxy dejaba el motor abierto a Internet.
ITM_TRUST_PROXY=0
# v1.27.6 · Fuerza la exigencia de token en cualquier escenario, incluido loopback.
ITM_REQUIRE_TOKEN=1
# v1.27.6 · auto | 1 | 0. En 'auto' la cookie se marca Secure solo si la petición
# llega por HTTPS (o X-Forwarded-Proto=https con ITM_TRUST_PROXY=1). Forzar 1 sobre
# HTTP plano hace que el navegador descarte la cookie y produce bucle de redirección.
ITM_SESSION_HTTPS_ONLY=auto
# v1.27.6 · Vida de la credencial de sesión (segundos). La cookie ya NO contiene el
# token maestro: transporta un HMAC con caducidad. Rotar ITM_ACCESS_TOKEN expulsa
# a todas las sesiones vivas.
ITM_SESSION_TTL_SECONDS=43200
# Query-string token bootstrap se desactiva por defecto cuando ITM_PRODUCTION=1
# o ITM_ENV=production. En produccion preferir cookie ya emitida o cabecera desde proxy seguro.
ITM_ALLOW_QUERY_TOKEN_BOOTSTRAP=0
ITM_ENV=production
ITM_PRODUCTION=1

# ============================================================================
# ITM QUANT v1.27.0 · AGGRESSION TRIGGER + SOPHIA SELF-HOSTED
# ============================================================================
# Aggression LIVE: internal adaptive gates. UI only shows BUY/SELL/NEUTRAL candles.
ITM_AGG_LIVE_SCORE=66
ITM_AGG_LIVE_Z=0.85
ITM_AGG_LIVE_IMBALANCE=0.10
ITM_AGG_MIN_COVERAGE=0.55
ITM_AGG_MIN_TRADES=4

# Sophia: local/self-hosted ONLY. URL must resolve to localhost/loopback.
# Ollama example: http://127.0.0.1:11434/api/chat
# llama.cpp/OpenAI-compatible example: http://127.0.0.1:8080/v1/chat/completions
ITM_SOPHIA_LLM_URL=
ITM_SOPHIA_LLM_MODEL=itm-sophia-local
ITM_SOPHIA_UNUSUAL_SCORE=70

# Local speech-to-text. faster-whisper is preferred; whisper.cpp is supported.
ITM_SOPHIA_STT_MODEL=small
ITM_SOPHIA_STT_DEVICE=cpu
ITM_SOPHIA_STT_COMPUTE=int8
ITM_SOPHIA_WHISPER_CLI=
ITM_SOPHIA_WHISPER_MODEL_PATH=

# Local text-to-speech. Windows SAPI works without these; Piper is optional.
ITM_SOPHIA_PIPER_CLI=
ITM_SOPHIA_PIPER_MODEL=

# v1.27.10 · Sección observacional de anomalías en rendimientos logarítmicos.
# Apagada por defecto. Es una sección aparte: no participa en el Scanner ni
# altera ningún cálculo del motor. Ponga 1 solo si quiere verla.

# v1.27.13: never accept the master token from cookies by default.
ITM_ALLOW_LEGACY_COOKIE=0

# v1.27.13 bounded Rust causality pipeline
ITM_RUST_OUTBOUND_CAPACITY=250000
ITM_RUST_HEAP_CAPACITY=200000
